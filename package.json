{
  "name": "drafthouse",
  "version": "0.1.0",
  "private": true,
  "description": "Plan a home remodel in 3D: draw your rooms, paste product links, and move the products around at their real size.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:factory": "node --test scripts/factory/next-step.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:factory && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-html-parser": "9.0.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
